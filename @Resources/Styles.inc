[StyleText]
FontFace=#FontName#
FontSize=#FontSize#
AntiAlias=1
DynamicVariables=1

[StyleIcon]
FontFace=#IconFont#
AntiAlias=1
DynamicVariables=1

[StyleChannel]
FontFace=#FontName#
FontSize=(#FontSize# + 0.5)
FontWeight=600
FontColor=#ColorChannel#
AntiAlias=1
ClipString=1
StringAlign=LeftCenter
W=(#SkinWidth# - #PaddingX# * 2 - 22 - #PillWidth# - 6)
DynamicVariables=1

[StyleName]
FontFace=#FontName#
FontSize=#FontSize#
AntiAlias=1
ClipString=1
StringAlign=LeftCenter
W=(#SkinWidth# - #PaddingX# * 2 - #AvatarSize# - 9 - 22)
DynamicVariables=1

[StyleInitial]
FontFace=#FontName#
FontSize=(#FontSize# - 2)
FontWeight=700
AntiAlias=1
StringAlign=CenterCenter
DynamicVariables=1
