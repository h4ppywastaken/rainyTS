[Variables]
; ---- TS6 Remote Apps connection ----
TS6_Host=127.0.0.1
TS6_Port=5899

; ---- UI limits ----
MaxUsers=24

; ---- Theme colors (R,G,B,A) ----
; Card background is a vertical gradient from top to bottom.
ColorBGTop=32,34,41,246
ColorBGBottom=21,22,27,246
ColorBorder=255,255,255,26
ColorHighlight=255,255,255,16
ColorShadow=0,0,0,70
ColorShadowSoft=0,0,0,28
ColorDivider=255,255,255,18
; Accent: header icon and channel name
ColorAccent=110,168,255,255
ColorChannel=236,238,244,255
ColorPill=255,255,255,20
; User names
ColorText=214,217,224,255
ColorTextBright=255,255,255,255
ColorTextDim=128,133,146,255
; Avatars
ColorAvatarIdle=56,60,71,255
ColorAvatarText=200,204,214,255
; Status
ColorTalk=52,211,120,255
ColorTalkInk=10,40,22,255
ColorTalkRing=52,211,120,150
ColorTalkRow=52,211,120,24
ColorMicMute=245,180,60,255
ColorFullMute=240,90,90,255

; ---- Layout (px) ----
SkinWidth=240
CornerRadius=10
; Transparent space around the card for the drop shadow
Margin=6
PaddingX=12
PaddingY=10
HeaderHeight=34
LineHeight=26
AvatarSize=20
PillWidth=40

; ---- Fonts ----
FontName=Segoe UI
FontSize=10
; Windows 11: Segoe Fluent Icons / Windows 10: Segoe MDL2 Assets
IconFont=Segoe Fluent Icons
